# Copy to .env and fill in whichever you have. None are required -- the app
# falls back to heuristic scoring for GEO and a response-time/page-weight
# proxy for Core Web Vitals if these are absent.

# GEO qualitative scoring (tried in this order). Groq's free tier is recommended:
# https://console.groq.com/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Real Core Web Vitals via Google PageSpeed Insights (free, no billing required):
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
